# OpenAI API (world editor only - required for world creation)
OPENAI_API_KEY=sk-...
OPENAI_WORLD_EDITOR_MODEL=gpt-4o

# Local LLM endpoint (OpenAI-compatible, e.g. Ollama, llama.cpp)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.3:70b
LOCAL_LLM_API_KEY=ollama

# Simulation settings
WORLD_WIDTH=100.0
WORLD_HEIGHT=100.0
SIM_HZ=25
MOVEMENT_HZ=8
STIMULATION_HZ=15
LLM_INTERVAL_SECONDS=6.0
MEMORY_CONSOLIDATION_MINUTES=5.0

# Database
DB_PATH=creature_world.db

# Server
HOST=0.0.0.0
PORT=8000
